# Database URL. Local dev defaults to SQLite and needs no value; production points
# at the shared Postgres on petel. The real value lives on LUKS / 1Password.
TA_DATABASE_URL=postgresql+psycopg://target_analyzer:CHANGE_ME@192.168.1.206:5432/target_analyzer

# Session-cookie signing key. Generate a random one; never commit the real value.
TA_SECRET_KEY=change-me

# true in production (HTTPS via the gateway Caddy); false for local http dev.
TA_SECURE_COOKIES=true

# sha256 of the machine bearer token the Mac client uses for POST /api/ingest.
# Mint it with `python -m target_analyzer.create_token`; store only the hash here.
TA_INGEST_TOKEN_HASH=

# Comma-separated CIDR ranges allowed to reach the app (LAN + Tailscale CGNAT).
TA_ALLOWED_RANGES=127.0.0.1/32,192.168.0.0/16,100.64.0.0/10

# Where originals + normalized images are stored on the server (LUKS SSD in prod).
TA_DATA_PATH=/data

# Max accepted upload size, in bytes.
TA_ATTACHMENT_MAX_BYTES=26214400

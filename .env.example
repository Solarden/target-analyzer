# Copy to the gitignored .env beside it. Running the app directly, every setting here is
# read from it; through the compose stack, only the ones docker-compose.yml names arrive.

# Database URL. Local dev defaults to SQLite and needs no value; production points
# at a Postgres instance. Never commit the real value. The role and the database have to
# exist on that instance first — the README's Deployment section has the two statements.
TA_DATABASE_URL=postgresql+psycopg://target_analyzer:CHANGE_ME@db.example.internal:5432/target_analyzer

# Session-cookie signing key. Generate a random one; never commit the real value.
TA_SECRET_KEY=change-me

# Mark the session cookie Secure, so the browser only sends it over HTTPS. The default;
# set it false only for plain-http local dev, where the browser drops it and the login loops.
TA_SECURE_COOKIES=true

# sha256 of the machine bearer token the Mac client uses for POST /api/ingest.
# Mint it with `python -m target_analyzer.create_token`; store only the hash here.
TA_INGEST_TOKEN_HASH=

# Where originals + normalized images are stored. The compose file pins this to the
# mounted /data volume; running the app directly, point it at a writable directory.
TA_DATA_PATH=/data

# Max accepted upload size, in bytes.
TA_ATTACHMENT_MAX_BYTES=26214400

# Read by docker-compose.yml and the Caddyfile, never by the app: the name the app is
# browsed at, which Caddy issues its certificate for. It must resolve to the host.
TA_SITE_ADDRESS=target.local

# Access is restricted to private LAN ranges by the Caddyfile, not by the app. Replacing
# that proxy means rebuilding the restriction in whatever takes its place.

# The Mac client's settings are NOT here. They live in ~/.config/target-analyzer/env
# (see the README): that file holds the bearer token itself, and a TA_INGEST_TOKEN line
# in the checkout would invite putting a real one where the client never reads it.

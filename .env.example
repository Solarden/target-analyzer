# Database URL. Local dev defaults to SQLite and needs no value; production points
# at a Postgres instance. Never commit the real value.
TA_DATABASE_URL=postgresql+psycopg://target_analyzer:CHANGE_ME@db.example.internal:5432/target_analyzer

# Session-cookie signing key. Generate a random one; never commit the real value.
TA_SECRET_KEY=change-me

# true in production (HTTPS via a reverse proxy); false for local http dev.
TA_SECURE_COOKIES=true

# sha256 of the machine bearer token the Mac client uses for POST /api/ingest.
# Mint it with `python -m target_analyzer.create_token`; store only the hash here.
TA_INGEST_TOKEN_HASH=

# Comma-separated CIDR ranges allowed to reach the app; covers loopback, private
# LAN, and the CGNAT range used by mesh VPNs. Read by the *gateway* Caddy (@notlan
# -> 403), not by the app — pydantic never sees it, same as EA_BACKUP_KEEP in EA.
TA_ALLOWED_RANGES=127.0.0.1/32,192.168.0.0/16,100.64.0.0/10

# Where originals + normalized images are stored on the server.
TA_DATA_PATH=/data

# Max accepted upload size, in bytes.
TA_ATTACHMENT_MAX_BYTES=26214400
